{
  "name": "spark-controller-desktop",
  "version": "0.1.0",
  "description": "SparklingTones per Windows",
  "author": "SparklingTones",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.sparklingtones.controller",
    "productName": "SparklingTones",
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "connessione-veloce.ps1",
        "to": "connessione-veloce.ps1"
      },
      {
        "from": "../pc.html",
        "to": "web/pc.html"
      },
      {
        "from": "../pc.webmanifest",
        "to": "web/pc.webmanifest"
      },
      {
        "from": "../icons",
        "to": "web/icons"
      },
      {
        "from": "../fonts",
        "to": "web/fonts"
      },
      {
        "from": "../immagini",
        "to": "web/immagini"
      },
      {
        "from": "../src",
        "to": "web/src",
        "filter": [
          "**/*",
          "!app/**"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "SparklingTones",
      "artifactName": "SparklingTones-Setup-${version}.exe"
    }
  }
}
