{
  "name": "spark-controller-desktop",
  "version": "0.1.0",
  "description": "Spark 2 Controller per Windows",
  "author": "Spark Controller",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.sparklingtones.controller",
    "productName": "Spark Controller",
    "files": ["main.js", "preload.js", "package.json"],
    "extraResources": [
      { "from": "../pc.html", "to": "web/pc.html" },
      { "from": "../pc.webmanifest", "to": "web/pc.webmanifest" },
      { "from": "../icons", "to": "web/icons" },
      { "from": "../fonts", "to": "web/fonts" },
      { "from": "../src", "to": "web/src", "filter": ["**/*", "!app/**"] }
    ],
    "win": {
      "target": "nsis",
      "icon": "../icons/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Spark Controller",
      "artifactName": "SparkController-Setup-${version}.exe"
    }
  }
}
